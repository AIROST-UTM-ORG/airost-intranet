# Test environment — used by Jest via cross-env NODE_ENV=test
# This file is safe to commit; it contains NO real credentials.
# Tests use mongodb-memory-server and never connect to the production DB.

NODE_ENV=test
PORT=4001
PASSPORT_SECRET=test-secret-safe-for-ci
REACT_APP_URL=http://localhost:3000

# Intentionally blank — tests use mongodb-memory-server
MONGODB_URI=
MONGO_URI=

# Intentionally blank — Google OAuth is not exercised in unit/integration tests
GOOGLE_CLIENT_ID= "dummy_google_client_id"
GOOGLE_CLIENT_SECRET= "dummy_client_secret_id"

# Intentionally blank — Calendar tests are skipped
CALENDAR_ID=
CREDENTIALS=
