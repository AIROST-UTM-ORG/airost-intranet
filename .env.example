# Server runtime configuration
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://mongodb:27017/airost_intranet
PASSPORT_SECRET=local_dev_passport_secret

# Google OAuth 2.0 Credentials (optional for local dev unless testing OAuth login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Client web application URL
REACT_APP_URL=http://localhost:3000

# Cookie security settings (false for local HTTP, true for HTTPS)
COOKIE_SECURE=false

# Google Calendar Integration (Optional)
CALENDAR_ID=none
CREDENTIALS={}
