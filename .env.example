# =================================================================
# Airost Intranet Environment Configuration Template (.env)
# =================================================================
# Note: The client container serves static assets and uses relative API
# routing via Nginx reverse proxy. Therefore, NO client-side environment
# variables (such as REACT_APP_API_URL) are required!
#
# Configure these variables in Doppler or your local .env file.
# =================================================================

# Server runtime port (internal container port)
PORT=8080

# Environment mode (production, development, test)
NODE_ENV=production

# MongoDB connection string
MONGO_URI=mongodb://mongodb:27017/airost_intranet

# Session secret used for signing session cookies
PASSPORT_SECRET=replace_with_a_secure_random_session_secret

# Google OAuth Credentials for user login
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Public web application URL (used for redirects / CORS)
# In production with Nginx reverse proxy, leave empty or set to host URL (e.g. http://100.115.152.102 or https://intranet.airost.org)
REACT_APP_URL=

# Cookie security settings
# Set to 'true' when running behind HTTPS (SSL), or 'false' for HTTP / LAN IP deployments
COOKIE_SECURE=false

# Google Calendar Integration (Optional)
CALENDAR_ID=none
CREDENTIALS={}
